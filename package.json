{
  "name": "@hostsmith/sdk",
  "version": "1.0.1",
  "description": "Node.js SDK for the Hostsmith Public API",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/hostsmith/js-sdk#readme",
  "bugs": {
    "url": "https://github.com/hostsmith/js-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsdown": "^0.11.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  },
  "keywords": [
    "hostsmith",
    "hosting",
    "deploy",
    "sdk",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hostsmith/js-sdk"
  }
}
